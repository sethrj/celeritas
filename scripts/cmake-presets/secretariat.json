{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": ".base",
      "hidden": true,
      "inherits": ["full", ".nobuiltin"],
      "binaryDir": "/scratch/$env{USER}/build/celeritas-${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": { "type": "BOOL", "value": "ON" },
        "CELERITAS_BUILD_DOCS": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_CUDA": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HIP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_OpenMP": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_MPI": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_PNG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_ROOT": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_DD4hep": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_LArSoft": { "type": "BOOL", "value": "OFF" },
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -Werror -Wno-stringop-overread -fdiagnostics-color",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_EXTENSIONS": { "type": "BOOL", "value": "OFF" },
        "CMAKE_INSTALL_PREFIX": "/scratch/$env{USER}/install/celeritas-${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": ".orange",
      "hidden": true,
      "cacheVariables": {
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "OFF" },
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-z,defs",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,-z,defs"
      }
    },
    {
      "name": "hip-temp",
      "inherits": [".orange", ".base", ".reldeb"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic -Werror -fdiagnostics-color=always",
        "CELERITAS_USE_Geant4": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_HIP": { "type": "BOOL", "value": "ON" }
      },
      "environment": {
        "PATH": "/scratch/celeritas/hip-view/bin:/scratch/celeritas/hip-view:/auto/projects/celeritas/spack/bin:/home/s3j/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "CMAKE_PREFIX_PATH": "/scratch/celeritas/hip-env",
        "HIPIFY_CLANG_PATH": "/scratch/celeritas/hip-view",
        "HIPCC_LINK_FLAGS_APPEND": "--rocm-path=/scratch/celeritas/hip-view",
        "HIPCC_COMPILE_FLAGS_APPEND": "--rocm-path=/scratch/celeritas/hip-view -isystem /scratch/celeritas/hip-view/include",
        "HIP_PLATFORM": "amd",
        "HIP_DEVICE_LIB_PATH": "/scratch/celeritas/hip-view/amdgcn/bitcode",
        "HIP_CLANG_PATH": "/scratch/celeritas/hip-view/bin",
        "HIP_COMPILER": "clang",
        "ROCMINFO_PATH": "/scratch/celeritas/hip-view",
        "ROCM_PATH": "/scratch/celeritas/hip-view"
      }
    },
    {
      "name": "release-vecgeom",
      "displayName": "Build with full optimizations (VecGeom)",
      "inherits": [".base", ".release"],
      "cacheVariables": {
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "reldeb-vecgeom",
      "displayName": "Build with optimizations, but enable host debugging (VecGeom)",
      "inherits": [".base", ".reldeb"],
      "cacheVariables": {
        "CELERITAS_DEVICE_DEBUG": { "type": "BOOL", "value": "OFF" },
        "CELERITAS_USE_VecGeom": { "type": "BOOL", "value": "ON" }
      }
    },
    {
      "name": "release-orange",
      "displayName": "Build with full optimizations (ORANGE)",
      "inherits": [".orange", ".base", ".release"]
    },
    {
      "name": "reldeb-orange",
      "displayName": "Build with optimizations, but enable host debugging (ORANGE)",
      "inherits": [".orange", ".base", ".reldeb"]
    },
    {
      "name": "debug-orange",
      "displayName": "Build without optimization, enabling full host debugging (ORANGE)",
      "inherits": [".orange", ".base", ".debug"],
      "cacheVariables": {
        "CELERITAS_DEVICE_DEBUG": { "type": "BOOL", "value": "OFF" }
      }
    }
  ],
  "buildPresets": [
    {
      "name": ".base",
      "configurePreset": ".base",
      "jobs": 48,
      "nativeToolOptions": ["-k0"]
    },
    {
      "name": "release-vecgeom",
      "configurePreset": "release-vecgeom",
      "inherits": ".base"
    },
    {
      "name": "reldeb-vecgeom",
      "configurePreset": "reldeb-vecgeom",
      "inherits": ".base"
    },
    {
      "name": "release-orange",
      "configurePreset": "release-orange",
      "inherits": ".base"
    },
    {
      "name": "reldeb-orange",
      "configurePreset": "reldeb-orange",
      "inherits": ".base"
    },
    {
      "name": "debug-orange",
      "configurePreset": "debug-orange",
      "inherits": ".base"
    }
  ],
  "testPresets": [
    {
      "name": ".base",
      "configurePreset": ".base",
      "output": { "outputOnFailure": true },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    },
    {
      "name": "release-vecgeom",
      "configurePreset": "release-vecgeom",
      "inherits": ".base"
    },
    {
      "name": "reldeb-vecgeom",
      "configurePreset": "reldeb-vecgeom",
      "inherits": ".base"
    },
    {
      "name": "release-orange",
      "configurePreset": "release-orange",
      "inherits": ".base"
    },
    {
      "name": "reldeb-orange",
      "configurePreset": "reldeb-orange",
      "inherits": ".base"
    },
    {
      "name": "debug-orange",
      "configurePreset": "debug-orange",
      "inherits": ".base"
    }
  ]
}
